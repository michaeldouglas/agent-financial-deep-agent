# Default is the remote brapi.dev MCP. For local mocks, set MCP_PROVIDER=local
# and start Compose with: docker compose --profile local-mcp up
MCP_PROVIDER=brapi
MCP_BRAPI_URL=https://brapi.dev/api/mcp/mcp
MCP_LOCAL_URL=http://mcp-financial:8081/mcp

# Optional BRAPI API token. Keep this value private and out of Git.
BRAPI_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
