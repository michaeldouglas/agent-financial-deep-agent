{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-financial.local/schemas/document-v1.schema.json",
  "title": "Financial chat document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "title", "metadata", "sections"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_type": {"enum": ["report", "statement", "proposal", "summary", "other"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "subtitle": {"type": "string", "maxLength": 300},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": {"enum": ["demonstration", "user-provided", "connected-source"]},
        "generated_at": {"type": "string", "maxLength": 80},
        "as_of": {"type": "string", "maxLength": 100},
        "period": {"type": "string", "maxLength": 160},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "source": {"type": "string", "maxLength": 200},
        "notice": {"type": "string", "maxLength": 1000},
        "language": {"enum": ["pt-BR", "en-US"]}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "blocks"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 180},
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {"oneOf": [{"$ref": "#/definitions/heading"}, {"$ref": "#/definitions/paragraph"}, {"$ref": "#/definitions/list"}, {"$ref": "#/definitions/table"}, {"$ref": "#/definitions/indicator"}, {"$ref": "#/definitions/callout"}, {"$ref": "#/definitions/page_break"}]}
          }
        }
      }
    },
    "footer": {"type": "string", "maxLength": 500}
  },
  "allOf": [
    {
      "if": {"properties": {"metadata": {"type": "object", "properties": {"classification": {"const": "demonstration"}}, "required": ["classification"]}}, "required": ["metadata"]},
      "then": {"properties": {"metadata": {"type": "object", "required": ["classification", "notice"]}}}
    },
    {
      "if": {"properties": {"metadata": {"type": "object", "properties": {"classification": {"const": "connected-source"}}, "required": ["classification"]}}, "required": ["metadata"]},
      "then": {"properties": {"metadata": {"type": "object", "required": ["classification", "source"]}}}
    }
  ],
  "definitions": {
    "heading": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "level", "text"],
      "properties": {"type": {"const": "heading"}, "level": {"enum": ["h2", "h3"]}, "text": {"type": "string", "minLength": 1, "maxLength": 180}}
    },
    "paragraph": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {"type": {"const": "paragraph"}, "text": {"type": "string", "maxLength": 5000}}
    },
    "list": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "ordered", "items"],
      "properties": {"type": {"const": "list"}, "ordered": {"type": "boolean"}, "items": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "maxLength": 1000}}}
    },
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "columns", "rows"],
      "properties": {
        "type": {"const": "table"},
        "caption": {"type": "string", "maxLength": 180},
        "columns": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "label"],
            "properties": {"key": {"type": "string", "minLength": 1, "maxLength": 80}, "label": {"type": "string", "minLength": 1, "maxLength": 100}, "align": {"enum": ["left", "center", "right"]}, "format": {"enum": ["text", "number", "currency", "percent", "date"]}}
          }
        },
        "rows": {
          "type": "array", "maxItems": 200,
          "items": {"type": "object", "additionalProperties": {"anyOf": [{"type": "string", "maxLength": 1000}, {"type": "number"}, {"type": "null"}]}}
        }
      }
    },
    "indicator": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "label", "value"],
      "properties": {"type": {"const": "indicator"}, "label": {"type": "string", "minLength": 1, "maxLength": 120}, "value": {"anyOf": [{"type": "string", "maxLength": 120}, {"type": "number"}]}, "unit": {"type": "string", "maxLength": 40}, "trend": {"enum": ["up", "down", "neutral"]}, "detail": {"type": "string", "maxLength": 500}}
    },
    "callout": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "tone", "text"],
      "properties": {"type": {"const": "callout"}, "tone": {"enum": ["info", "warning", "success"]}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}}
    },
    "page_break": {
      "type": "object", "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "page_break"}}
    }
  }
}
